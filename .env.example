# Copy to .env.local and fill in values. Never commit real secrets.

# Neon Postgres — set automatically by Vercel Marketplace Neon as DATABASE_URL
# (POSTGRES_URL is also accepted). Leave unset/placeholder for local file store.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# POSTGRES_URL=

# Required on Vercel even when Neon is linked (not auto-provisioned by Neon):
# Random secret for signing session cookies (e.g. openssl rand -base64 32)
SESSION_SECRET=change-me-to-a-long-random-string

# Bootstraps the single admin account if none exists yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password
